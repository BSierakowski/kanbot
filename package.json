{
  "name": "kanbot",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "npm run typecheck && npm run migrate",
    "typecheck": "tsc",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "discord:register": "tsx --env-file-if-exists=.env scripts/register-discord-commands.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.9",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
